generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TENANT
  LANDLORD
  ADMIN
}
enum ListingStatus {
  DRAFT
  PENDING_PAYMENT
  PUBLISHED
  PAUSED
  ARCHIVED
}
enum BookingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}
enum PayoutStatus {
  HELD
  PROCESSING
  RELEASED
  FAILED
}
enum PaymentKind {
  LISTING
  RENTAL
  SUCCESS_FEE
  SUBSCRIPTION
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String?
  googleId String? @unique
  role Role @default(TENANT)
  name String
  phone String?
  avatarUrl String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  listings Listing[]
  bookings Booking[]
  reviews Review[]
  sentMessages Message[]
  conversationsA Conversation[] @relation("Tenant")
  conversationsB Conversation[] @relation("Landlord")
  notifications Notification[]
  subscriptions Subscription[]
  payments Payment[]
  paystackSubaccountCode String?
  paystackTransferRecipientCode String?
  emailVerificationTokens EmailVerificationToken[]
}
model EmailVerificationToken {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete: Cascade)

  @@index([userId])
}
model Listing {
  id String @id @default(cuid())
  landlordId String
  title String
  description String
  price Int
  location String
  type String
  amenities String[]
  photos String[]
  availability Json
  trialEndsAt DateTime?
  status ListingStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  landlord User @relation(fields:[landlordId],references:[id])
  bookings Booking[]
  reviews Review[]
  payments Payment[]
}
model Booking {
  id String @id @default(cuid())
  listingId String
  tenantId String
  startAt DateTime
  endAt DateTime
  status BookingStatus @default(REQUESTED)
  note String?
  createdAt DateTime @default(now())
  listing Listing @relation(fields:[listingId],references:[id])
  tenant User @relation(fields:[tenantId],references:[id])
  payment Payment?
  matchedAt DateTime?
  leaseAmount Int?
}
model Conversation {
  id String @id @default(cuid())
  tenantId String
  landlordId String
  listingId String?
  createdAt DateTime @default(now())
  tenant User @relation("Tenant",fields:[tenantId],references:[id])
  landlord User @relation("Landlord",fields:[landlordId],references:[id])
  messages Message[]
  @@unique([tenantId,landlordId,listingId])
}
model Message {
  id String @id @default(cuid())
  conversationId String
  senderId String
  body String
  createdAt DateTime @default(now())
  readAt DateTime?
  conversation Conversation @relation(fields:[conversationId],references:[id])
  sender User @relation(fields:[senderId],references:[id])
}
model Review {
  id String @id @default(cuid())
  listingId String
  authorId String
  rating Float
  comment String
  createdAt DateTime @default(now())
  listing Listing @relation(fields:[listingId],references:[id])
  author User @relation(fields:[authorId],references:[id])
}
model Payment {
  id String @id @default(cuid())
  bookingId String? @unique
  listingId String?
  payerId String
  kind PaymentKind @default(RENTAL)
  reference String @unique
  amount Int
  agencyFee Int @default(0)
  landlordShare Int @default(0)
  status PaymentStatus @default(PENDING)
  payoutStatus PayoutStatus @default(HELD)
  payoutReference String? @unique
  releasedAt DateTime?
  createdAt DateTime @default(now())
  booking Booking? @relation(fields:[bookingId],references:[id])
  listing Listing? @relation(fields:[listingId],references:[id])
  payer User @relation(fields:[payerId],references:[id])
}
model Subscription {
  id String @id @default(cuid())
  landlordId String
  plan String
  reference String? @unique
  status PaymentStatus @default(PENDING)
  startsAt DateTime?
  endsAt DateTime?
  trialEndsAt DateTime?
  paystackSubscriptionCode String? @unique
  paystackEmailToken String?
  dunningAttempts Int @default(0)
  landlord User @relation(fields:[landlordId],references:[id])
}
model Notification {
  id String @id @default(cuid())
  userId String
  type String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
}
